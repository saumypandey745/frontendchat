# ChatWave Frontend Environment Variables (Vercel Deployment)

# Render Backend URLs (Replace with your actual Render service domain)
VITE_API_URL=https://chatwave-backend.onrender.com/api
VITE_SOCKET_URL=https://chatwave-backend.onrender.com

# Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Frontend Application Base URL (Vercel production URL)
VITE_APP_URL=https://chatwave.vercel.app

# GIPHY API Key for GIF Search
VITE_GIPHY_API_KEY=dc6zaTOxFJmzC
